{
   "workspace": {
      "checkThirdParty": false,
      "useGitIgnore": false,
      "ignoreDir": [
         ".vscode",
         "start",
         "wiki",
         "docs",
         "media",
         ".git",
         ".VSCOdeCounter"
      ],
      "library": [
         "src/API/"
      ]
   },
   "runtime": {
      "version": "Lua 5.1",
      "fileEncoding": "utf8",
      "special": {},
      "builtin": {
         "jit": "disable",
         "io": "disable",
         "os": "disable",
         "utf8": "disable",
         "package": "disable",
         "bit32": "disable",
         "bit": "disable",
         "ffi": "disable",
         "coroutine": "enable"
      }
   },
   "completion": {
      "autoRequire": false,
      "showParams": true,
      "enable": true,
      "showWord": "Enable",
      "postfix": "@",
      "workspaceWord": true,
      "displayContext": 2
   },
   "window": {
      "progressBar": true,
      "statusBar": true
   },
   "type": {
      "castNumberToInteger": true,
      "weakNilCheck": false,
      "weakUnionCheck": false,
      "checkTableShape": true
   },
   "typeFormat": {
      "config": {
         "format_line": "true",
         "auto_complete_end": "true",
         "auto_complete_table_sep": "true"
      }
   },
   "diagnostics": {
      "groupFileStatus": {
         "redefined": "Any",
         "unbalanced": "Any",
         "luadoc": "Any",
         "ambiguity": "Any",
         "await": "Any",
         "strict": "Any",
         "codestyle": "None",
         "duplicate": "Any",
         "global": "Any",
         "type-check": "Any",
         "strong": "Any",
         "unused": "Any"
      },
      "enable": true,
      "globals": [
         "OutputLCDMessage",
         "PlayMacro",
         "AbortMacro",
         "OutputLogMessage",
         "ClearLog",
         "GetRunningTime",
         "GetMKeyState",
         "Sleep",
         "SetMKeyState",
         "MoveMouseToVirtual",
         "MoveMouseTo",
         "GetMousePosition",
         "MoveMouseRelative",
         "OutputDebugMessage",
         "SetBacklightColor",
         "ClearLCD",
         "ReleaseKey",
         "PressKey",
         "PressMouseButton",
         "ReleaseMouseButton",
         "IsKeyLockOn",
         "IsModifierPressed",
         "EnablePrimaryMouseButtonEvents",
         "MoveMouseWheel",
         "SetMouseDPITableIndex",
         "SetMouseDPITable"
      ],
      "severity": {
         "unused-vararg": "Hint!",
         "assign-type-mismatch": "Error!",
         "unused-local": "Hint!",
         "deprecated": "Warning!",
         "unused-function": "Hint!",
         "ambiguity-1": "Warning!",
         "empty-block": "Warning!",
         "missing-fields": "Warning!",
         "code-after-break": "Error!",
         "newline-call": "Warning!",
         "redefined-local": "Warning!",
         "undefined-env-child": "Warning!",
         "unused-label": "Warning!",
         "incomplete-signature-doc": "Hint!",
         "no-unknown": "Warning!",
         "await-in-sync": "Warning!"
      },
      "groupSeverity": {
         "redefined": "Error",
         "unbalanced": "Warning",
         "luadoc": "Warning",
         "ambiguity": "Warning",
         "await": "Error",
         "strict": "Warning",
         "codestyle": "Warning",
         "duplicate": "Error",
         "global": "Error",
         "type-check": "Warning",
         "strong": "Warning",
         "unused": "Warning",
         "conventions": "Warning"
      },
      "disable": [
         "incomplete-signature-doc",
         "unused-function"
      ],
      "ignoredFiles": "Disable",
      "libraryFiles": "Disable"
   },
   "hint": {
      "arrayIndex": "Disable",
      "await": true,
      "enable": true,
      "paramName": "Disable",
      "paramType": false,
      "setType": false
   },
   "spell.dict": [],
   "addonManager.enable": false,
   "telemetry.enable": false,
   "signatureHelp.enable": true,
   "format.enable": false,
   "codeLens.enable": false
}